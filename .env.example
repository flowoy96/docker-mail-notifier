# Beispielwerte für docker compose (in Portainer: Stack → „Environment variables“).
# Alles Weitere (SMTP, Empfänger, Ereignisse) wird im Webinterface eingestellt.

# Port des Webinterface auf dem Host
PORT=8080

# Zeitzone für Zeitangaben in den E-Mails
TZ=Europe/Berlin

# Schlüssel für das verschlüsselt gespeicherte SMTP-Passwort.
# Erzeugen z. B. mit:  openssl rand -base64 32
SECRET_KEY=
